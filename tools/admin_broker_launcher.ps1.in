# Generated with exact reviewed payload hashes. No credentials are accepted.
# ExecutionPolicy Bypass, if used by the .cmd wrapper, is process-local only.
$ErrorActionPreference = 'Stop'
$sourceFile = '@@SOURCE@@'
$expectedHash = '@@HASH@@'
$clientFile = '@@CLIENT@@'
$expectedClientHash = '@@CLIENT_HASH@@'
$ownerSid = '@@SID@@'
$identity = [Security.Principal.WindowsIdentity]::GetCurrent()
if ($identity.User.Value -ne $ownerSid) { throw 'Launch from the Windows account for which this helper was built.' }
$actual = (Get-FileHash -LiteralPath $sourceFile -Algorithm SHA256).Hash.ToLowerInvariant()
if ($actual -ne $expectedHash) { throw 'Helper bytes changed. Rebuild and review before elevation.' }
if ((Get-FileHash -LiteralPath $clientFile -Algorithm SHA256).Hash.ToLowerInvariant() -ne $expectedClientHash) { throw 'Client bytes changed. Rebuild and review.' }

# Reuse the already approved session. A second launch must not request UAC
# just because the original launcher's final status read failed.
$probeStart = [Diagnostics.ProcessStartInfo]::new($clientFile,'--client status')
$probeStart.UseShellExecute = $false; $probeStart.CreateNoWindow = $true
$probeStart.RedirectStandardOutput = $true; $probeStart.RedirectStandardError = $true
$probe = [Diagnostics.Process]::Start($probeStart)
$probeOutput = $probe.StandardOutput.ReadToEndAsync(); $probeError = $probe.StandardError.ReadToEndAsync()
if (-not $probe.WaitForExit(5000)) { $probe.Kill(); throw 'Existing helper check timed out. No new UAC was requested.' }
if ($probe.ExitCode -eq 0) {
    Write-Output $probeOutput.Result.Trim()
    Write-Host 'ClaudeReset helper is already ready. Existing approved session reused.'
    return
}
$activePath = [IO.Path]::Combine([Environment]::GetFolderPath('ProgramFiles'),'ClaudeResetAdmin','active.json')
if ([IO.File]::Exists($activePath)) {
    $active = [IO.File]::ReadAllText($activePath) | ConvertFrom-Json
    if ($active.state -eq 'ready') {
        $existing = Get-Process -Id $active.pid -ErrorAction SilentlyContinue
        if ($existing -and $existing.StartTime.ToUniversalTime().Ticks -eq $active.start_ticks) {
            throw ('An existing helper could not be verified. No new UAC was requested. '+$probeError.Result.Trim())
        }
    }
}

# These substitutions are generated values, not arguments supplied by requests.
$bootstrap = @'
$ErrorActionPreference = 'Stop'
function Assert-NoReparse([string]$path) {
    $item = [IO.Path]::GetFullPath($path)
    while ($item) {
        if (([IO.File]::GetAttributes($item) -band [IO.FileAttributes]::ReparsePoint) -ne 0) { throw 'Reparse point' }
        $item = [IO.Path]::GetDirectoryName($item)
    }
}
function Assert-Protected([string]$path, [bool]$directory) {
    Assert-NoReparse $path
    $acl = if ($directory) { [IO.Directory]::GetAccessControl($path) } else { [IO.File]::GetAccessControl($path) }
    if ($acl.GetOwner([Security.Principal.SecurityIdentifier]).Value -notin @('S-1-5-18','S-1-5-32-544')) { throw 'Untrusted owner' }
    if ($directory -and -not $acl.AreAccessRulesProtected) { throw 'Unprotected directory ACL' }
    $writeMask = 2 -bor 4 -bor 16 -bor 64 -bor 256 -bor 65536 -bor 262144 -bor 524288 -bor 0x10000000 -bor 0x40000000
    foreach ($rule in $acl.GetAccessRules($true,$true,[Security.Principal.SecurityIdentifier])) {
        if ($rule.AccessControlType -eq 'Allow' -and ([int]$rule.FileSystemRights -band $writeMask) -ne 0 -and $rule.IdentityReference.Value -notin @('S-1-5-18','S-1-5-32-544')) { throw 'Untrusted writer' }
    }
}
function New-ProtectedDirectory([string]$path) {
    Assert-NoReparse ([IO.Path]::GetDirectoryName($path))
    if (-not [IO.Directory]::Exists($path)) {
        $acl = [Security.AccessControl.DirectorySecurity]::new()
        $acl.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-32-544'))
        $acl.SetAccessRuleProtection($true,$false)
        foreach ($sid in @('S-1-5-18','S-1-5-32-544')) {
            $acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($sid),'FullControl','ContainerInherit,ObjectInherit','None','Allow'))
        }
        $acl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new('@@SID@@'),'ReadAndExecute','ContainerInherit,ObjectInherit','None','Allow'))
        [void][IO.Directory]::CreateDirectory($path,$acl)
    }
    Assert-Protected $path $true
}
try {
    $principal = [Security.Principal.WindowsPrincipal]::new([Security.Principal.WindowsIdentity]::GetCurrent())
    if (-not $principal.IsInRole([Security.Principal.WindowsBuiltInRole]::Administrator)) { throw 'Administrator token required' }
    $source = [IO.FileStream]::new('@@SOURCE@@',[IO.FileMode]::Open,[IO.FileAccess]::Read,[IO.FileShare]::Read)
    try {
        if ($source.Length -gt 4194304) { throw 'Payload size' }
        $sha = [Security.Cryptography.SHA256]::Create()
        try { $hash = [BitConverter]::ToString($sha.ComputeHash($source)).Replace('-','').ToLowerInvariant() } finally { $sha.Dispose() }
        if ($hash -ne '@@HASH@@') { throw 'Payload hash mismatch' }
        $root = [IO.Path]::Combine([Environment]::GetFolderPath('ProgramFiles'),'ClaudeResetAdmin')
        New-ProtectedDirectory $root
        $folder = [IO.Path]::Combine($root,$hash)
        New-ProtectedDirectory $folder
        if (@([IO.Directory]::GetFiles($folder) | Where-Object { [IO.Path]::GetFileName($_) -ne 'ClaudeResetAdminBroker.exe' }).Count -ne 0 -or [IO.Directory]::GetDirectories($folder).Length -ne 0) { throw 'Unexpected executable sidecar' }
        $target = [IO.Path]::Combine($folder,'ClaudeResetAdminBroker.exe')
        if (-not [IO.File]::Exists($target)) {
            $source.Position = 0
            $fileAcl = [Security.AccessControl.FileSecurity]::new()
            $fileAcl.SetOwner([Security.Principal.SecurityIdentifier]::new('S-1-5-32-544'))
            $fileAcl.SetAccessRuleProtection($true,$false)
            foreach ($sid in @('S-1-5-18','S-1-5-32-544')) { $fileAcl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new($sid),'FullControl','Allow')) }
            $fileAcl.AddAccessRule([Security.AccessControl.FileSystemAccessRule]::new([Security.Principal.SecurityIdentifier]::new('@@SID@@'),'ReadAndExecute','Allow'))
            $output = [IO.FileStream]::new($target,[IO.FileMode]::CreateNew,[Security.AccessControl.FileSystemRights]::Write,[IO.FileShare]::Read,4096,[IO.FileOptions]::None,$fileAcl)
            try { $source.CopyTo($output); $output.Flush($true) } finally { $output.Dispose() }
        }
        Assert-Protected $target $false
        $sha = [Security.Cryptography.SHA256]::Create()
        try { $installedHash = [BitConverter]::ToString($sha.ComputeHash([IO.File]::ReadAllBytes($target))).Replace('-','').ToLowerInvariant() } finally { $sha.Dispose() }
        if ($installedHash -ne $hash) { throw 'Installed payload differs' }
    } finally { $source.Dispose() }
    $temp = [IO.Path]::Combine($root,'temp'); New-ProtectedDirectory $temp
    $system = [Environment]::GetFolderPath('System')
    $start = [Diagnostics.ProcessStartInfo]::new($target,'--serve')
    $start.UseShellExecute = $false; $start.CreateNoWindow = $true; $start.WorkingDirectory = $folder
    $start.EnvironmentVariables.Clear()
    $start.EnvironmentVariables['SystemRoot'] = [IO.Path]::GetDirectoryName($system)
    $start.EnvironmentVariables['WINDIR'] = [IO.Path]::GetDirectoryName($system)
    $start.EnvironmentVariables['PATH'] = $system
    $start.EnvironmentVariables['TEMP'] = $temp; $start.EnvironmentVariables['TMP'] = $temp
    $process = [Diagnostics.Process]::Start($start)
    if ($process.WaitForExit(1500)) { throw ('Broker exited with code '+$process.ExitCode) }
    exit 0
} catch {
    # Do not write elevated error output to a caller-controlled workspace file.
    exit 41
}
'@

# Eliminate user-supplied CLR profiling/module search settings before launching
# the system PowerShell bootstrap. No machine or user environment is changed.
$systemDirectory = [Environment]::GetFolderPath('System')
foreach ($name in @([Environment]::GetEnvironmentVariables('Process').Keys)) {
    if ($name -match '^(COR_|CORECLR_|COMPLUS_|DOTNET_)') { [Environment]::SetEnvironmentVariable($name,$null,'Process') }
}
$env:PSModulePath = [IO.Path]::Combine($systemDirectory,'WindowsPowerShell\v1.0\Modules')
$env:PATH = $systemDirectory
$encoded = [Convert]::ToBase64String([Text.Encoding]::Unicode.GetBytes($bootstrap))
$start = [Diagnostics.ProcessStartInfo]::new([IO.Path]::Combine($systemDirectory,'WindowsPowerShell\v1.0\powershell.exe'))
$start.Arguments = '-NoProfile -NonInteractive -EncodedCommand '+$encoded
$start.UseShellExecute = $true; $start.Verb = 'runas'; $start.WindowStyle = 'Hidden'; $start.WorkingDirectory = $systemDirectory
Write-Host 'Confirm the single Windows UAC prompt for the reviewed ClaudeReset helper.'
$process = [Diagnostics.Process]::Start($start)
$process.WaitForExit()
if ($process.ExitCode -ne 0) { throw ('Bootstrap failed: '+$process.ExitCode+'. No operation was authorized by this failure.') }
& $clientFile --client status
if ($LASTEXITCODE -ne 0) { throw 'The helper did not pass the live client check.' }
Write-Host 'ClaudeReset helper is ready. No Claude network permissions were opened.'
